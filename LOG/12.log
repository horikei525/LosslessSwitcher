horikei@horikeinoMacBook-Air ~ % # 既存のプラグインを削除
sudo rm -rf /Library/Audio/Plug-Ins/HAL/LosslessSwitcherAudioPlugin.driver

# 新しいプラグインをコピー
sudo cp -RX /tmp/LosslessSwitcherAudioPlugin.driver /Library/Audio/Plug-Ins/HAL/ 

# アクセス権を設定
sudo chown -R root:wheel /Library/Audio/Plug-Ins/HAL/LosslessSwitcherAudioPlugin.driver
sudo chmod -R 755 /Library/Audio/Plug-Ins/HAL/LosslessSwitcherAudioPlugin.driver 

# CoreAudio の再起動
sudo killall -9 coreaudiod

